<!-- Diablo III (CUSA00243 1.47 Eternal Collection; CUSA00242 when the code matches): render resolution.
     The renderer's setup (eboot 0xbb1e4) sets its size in [obj+0x4c] / [obj+0x50] as
     sceKernelIsNeoMode() ? 3840x2160 : 1920x1080, and every screen-sized target (the display buffers,
     the scene, the post-process chain at a quarter) follows it; the 1536x1536 shadow map does not.
     Each patch replaces the base PS4's 1920 and 1080 (mov ecx, imm32), so the game renders at that size
     on the base PS4 path. Right after, [obj+0x54] = 16/9 (movl imm32 at 0x4bb218): the camera's
     aspect ratio, patched to width/height by the wider sizes. Found by SanctuaryPort; each site by its
     signature (Pattern/At). Each size has a second entry of the same name for the US 1.00 eboot
     (no PS4 Pro path: movl $1920/$1080/16:9 to [r14+0x48]/[r14+0x4c]/[r14+0x50] at 0x779a1f, GitHub
     #16); the first entry whose signatures are all found is applied. Above 900p the 1.00 entries also
     grow the 32 MiB heap the display buffers come from (0xd2d43f/61/9d) to 224 MiB as in 1.47, and ask
     for that much more direct memory. The game picks its font set by screen height (eboot 0x2015c1 and
     three more sites in 1.47, 0x17b47c and three more in 1.00: >2159, >1079, >899, >719 lines...),
     but the PS4 build only ships the 1080p and 2160p sets, so below 1080 lines no text was drawn
     (PR #15: the UI "disappears" at 720p/800p). The sizes below 1080 turn the ja after cmp $1079
     into jmp: the 1080p fonts, which the game scales to the screen. The 16:10 sizes write the
     camera's aspect ratio like the ultrawide ones. -->
<Patch>
    <TitleID>
        <ID>CUSA00243</ID>
        <ID>CUSA00242</ID>
    </TitleID>
    <Metadata Title="Diablo III" Name="Resolution Patch - 480p" Note="Renders at 854x480; text uses the 1080p fonts (the game has none for smaller screens)." Author="SanctuaryPort" PatchVer="1.0" AppVer="01.47" AppElf="eboot.bin" isEnabled="false">
        <PatchList>
            <Line Type="bytes" Address="0x004bb1ea" Value="56030000" Pattern="b8 00 0f 00 00 b9 80 07 00 00 0f 45 c8 41 89 4f 4c" At="6"/>
            <Line Type="bytes" Address="0x004bb202" Value="e0010000" Pattern="b8 70 08 00 00 b9 38 04 00 00 49 8d bf 10 0d 00 00 0f 45 c8 41 89 4f 50" At="6"/>
            <Line Type="bytes" Address="0x006015d4" Value="eb" Pattern="c7 45 a8 08 00 00 00 3d 37 04 00 00 77 2e" At="12"/>
            <Line Type="bytes" Address="0x00601aef" Value="eb" Pattern="37 41 b8 08 00 00 00 3d 37 04 00 00 77 2a" At="12"/>
            <Line Type="bytes" Address="0x00601f2b" Value="eb" Pattern="0e 03 00 8b 45 c8 bb 10 00 00 00 3d 6f 08 00 00 77 33 bb 08 00 00 00 3d 37 04 00 00 77 27" At="28"/>
