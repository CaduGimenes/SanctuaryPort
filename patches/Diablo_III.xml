<?xml version="1.0"?>
<!-- Diablo III (CUSA00243 1.47 Eternal Collection; CUSA00242 when the code matches): render resolution.
     The renderer's setup (eboot 0xbb1e4) sets its size in [obj+0x4c] / [obj+0x50] as
     sceKernelIsNeoMode() ? 3840x2160 : 1920x1080, and every screen-sized target (the display buffers,
     the scene, the post-process chain at a quarter) follows it; the 1536x1536 shadow map does not.
     Each patch replaces the base PS4's 1920 and 1080 (mov ecx, imm32), so the game renders at that size
     on the base PS4 path. Found by SanctuaryPort; each site by its signature (Pattern/At).
     The 21:9 entries also replace the aspect ratio the same setup stores at [obj+0x54]
     (mov dword [r15+0x54], 1.777780.. = 16:9): the camera projection reads it, so widening the
     render without it stretches the 3D picture (the UI adapts by render size, the projection does not). -->
<Patch>
    <TitleID>
        <ID>CUSA00243</ID>
        <ID>CUSA00242</ID>
    </TitleID>
    <Metadata Title="Diablo III" Name="Resolution Patch - 480p" Note="Renders at 854x480." Author="SanctuaryPort" PatchVer="1.0" AppVer="01.47" AppElf="eboot.bin" isEnabled="false">
        <PatchList>
            <Line Type="bytes" Address="0x004bb1ea" Value="56030000" Pattern="b8 00 0f 00 00 b9 80 07 00 00 0f 45 c8 41 89 4f 4c" At="6"/>
