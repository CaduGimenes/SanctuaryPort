// Writes GTAO visibility to the stock full-resolution R8 SSAO texture.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Params {
    vec4 projection;
    vec4 dims;
    vec4 p0;
    vec4 p1;
    vec4 p2;
} pc;
layout(binding = 0) uniform sampler2D aoIn;
layout(binding = 2, r8) uniform writeonly image2D stockAo;

// Write GTAO visibility straight to the stock SSAO output with no screen-edge vignette fade:
// gtao_evaluate.comp stops rays at the viewport bounds rather than clamping depth, so it does not
// produce the border halos Diablo III's 64x64 SSAO vignette mask was painted to hide.
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.dims.xy)))) return;
    float visibility = texelFetch(aoIn, p, 0).r;
    imageStore(stockAo, p, vec4(clamp(visibility, 0.0, 1.0)));
}
