// sanctuary: frame generation keeps each frame's depth (a depth target without transfer usage)
// as a 32-bit float color image.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1, r32f) uniform writeonly image2D depth_out;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(depth_out)))) {
        return;
    }
    imageStore(depth_out, pixel, vec4(texelFetch(depth_tex, pixel, 0).r));
}
