// Conservatively find the changed 16x16 depth tiles an evaluator tile can reach.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D tileData;
layout(binding = 2, r32f) uniform writeonly image2D recomputeTiles;

void main() {
    ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(tileData, 0);
    if (any(greaterThanEqual(tile, size))) return;
    float packed = texelFetch(tileData, tile, 0).r;
    bool dirty = packed < 0.0;
    int radius = int(abs(packed)) - 1;
    if (!dirty && radius > 0) {
        // Every selected nearest mip 0–4 texel contains source pixels of a single
        // aligned tile. Compare the minimum separation of the two tile rectangles.
        // The classifier pads the bound for rounding and the normal stencil.
        int reach_y = radius / 16 + 1;
        int min_y = max(0, tile.y - reach_y);
        int max_y = min(size.y - 1, tile.y + reach_y);
        for (int y = min_y; y <= max_y && !dirty; ++y) {
            int dy = max(abs(y - tile.y) - 1, 0) * 16;
            int reach_x = int(ceil(sqrt(float(radius * radius - dy * dy)))) / 16 + 1;
            int min_x = max(0, tile.x - reach_x);
            int max_x = min(size.x - 1, tile.x + reach_x);
            for (int x = min_x; x <= max_x; ++x) {
                if (texelFetch(tileData, ivec2(x, y), 0).r < 0.0) {
                    dirty = true;
                    break;
                }
            }
        }
    }
    imageStore(recomputeTiles, tile, vec4(dirty ? 1.0 : 0.0));
}
