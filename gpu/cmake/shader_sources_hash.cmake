# sanctuary: writes ${OUT} with SANCTUARY_SHADER_SOURCES_HASH, the first 32 bits of the SHA-256 of
# the files listed in ${LIST} (the shader translator and what builds a shader's runtime info). The
# on-disk shader cache mixes it into its version, so a build that translates shaders differently
# never reuses SPIR-V an older build saved (GitHub #19: a version bump was forgotten once and
# players' old caches broke pipelines on AMD's Windows driver until they deleted the user folder).
file(STRINGS "${LIST}" files)
set(all "")
foreach(f IN LISTS files)
    file(SHA256 "${f}" one)
    string(APPEND all "${one}")
endforeach()
string(SHA256 digest "${all}")
string(SUBSTRING "${digest}" 0 8 short)
set(text "// Generated by cmake/shader_sources_hash.cmake: do not edit.\n#pragma once\n#define SANCTUARY_SHADER_SOURCES_HASH 0x${short}u\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if (NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
