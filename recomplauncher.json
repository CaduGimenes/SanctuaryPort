{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "SanctuaryPort",
  "repo": "CaduGimenes/SanctuaryPort",
  "game": {
    "kind": "folder",
    "label": "Your Diablo III dump from a PS4 you own: the folder with eboot.bin (CUSA00243, CUSA00242, CUSA00433 or CUSA00434).",
    "check": { "file": "eboot.bin", "ids": ["CUSA00243", "CUSA00242", "CUSA00433", "CUSA00434"] },
    "update": {
      "into": "update",
      "label": "Your 1.47 update dump (CUSA00243-UPDATE), if your game has one.",
      "accepts": "folder",
      "optional": true
    }
  },
  "start": {
    "program": ["SanctuaryPort.exe", "SanctuaryPort-linux-x86_64.AppImage"],
    "args": ["--play", "--game", "{game}", "--update", "{install}/update"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        { "path": "{install}/sanctuary.ini", "if": "{install}/SanctuaryPort.exe" },
        { "path": "{install}/SanctuaryPort-data/sanctuary.ini", "if": "{install}/AppRun" },
        { "path": "{install}/SanctuaryPort-data/sanctuary.ini", "if": "{install}/SanctuaryPort-data" },
        { "path": "{local}/sanctuaryport/sanctuary.ini" }
      ]
    },
    {
      "id": "app",
      "format": "json",
      "file": [
        { "path": "{install}/settings.json", "if": "{install}/SanctuaryPort.exe" },
        { "path": "{install}/SanctuaryPort-data/settings.json", "if": "{install}/AppRun" },
        { "path": "{install}/SanctuaryPort-data/settings.json", "if": "{install}/SanctuaryPort-data" },
        { "path": "{local}/sanctuaryport/settings.json" }
      ]
    }
  ],
  "saves": [
    "{install}/user/savedata",
    "{install}/SanctuaryPort-data/user/savedata",
    "{local}/sanctuaryport/user/savedata"
  ],
  "folders": {
    "saves": [
      { "path": "{install}/user/savedata", "if": "{install}/SanctuaryPort.exe" },
      { "path": "{install}/SanctuaryPort-data/user/savedata", "if": "{install}/AppRun" },
      { "path": "{install}/SanctuaryPort-data/user/savedata", "if": "{install}/SanctuaryPort-data" },
      { "path": "{local}/sanctuaryport/user/savedata" }
    ],
    "logs": [
      { "path": "{install}/user", "if": "{install}/SanctuaryPort.exe" },
      { "path": "{install}/SanctuaryPort-data/user", "if": "{install}/AppRun" },
      { "path": "{install}/SanctuaryPort-data/user", "if": "{install}/SanctuaryPort-data" },
      { "path": "{local}/sanctuaryport/user" }
    ]
  },
  "settings": [
    {
      "id": "display_mode",
      "label": "Window mode",
      "choices": [
        { "label": "Windowed", "set": { "display_mode": "windowed" } },
        { "label": "Borderless", "set": { "display_mode": "borderless" } },
        { "label": "Fullscreen", "set": { "display_mode": "fullscreen" } }
      ],
      "defaults": { "display_mode": "windowed" }
    },
    {
      "id": "render_resolution",
      "label": "Render resolution",
      "help": "What the game draws at. Native is the PS4's own 1080p.",
      "choices": [
        { "label": "720p", "set": { "render_resolution": "720p" } },
        { "label": "Native (1080p)", "set": { "render_resolution": "native" } },
        { "label": "1440p", "set": { "render_resolution": "1440p" } },
        { "label": "4K", "set": { "render_resolution": "4K" } }
      ],
      "defaults": { "render_resolution": "native" }
    },
    {
      "id": "upscaling",
      "label": "Upscaling",
      "help": "FSR 1 enlarges with more detail than a plain stretch. FSR 3 also smooths edges; heavy on handhelds.",
      "choices": [
        { "label": "Off", "set": { "temporal_aa": "off", "fsr1": "0" } },
        { "label": "FSR 1", "set": { "temporal_aa": "off", "fsr1": "1" } },
        { "label": "FSR 3", "set": { "temporal_aa": "fsr3", "fsr1": "0" } }
      ],
      "defaults": { "temporal_aa": "off", "fsr1": "0" }
    },
    {
      "id": "fxaa",
      "label": "FXAA",
      "help": "Smooths edges after the frame is drawn.",
      "choices": [
        { "label": "Off", "set": { "fxaa": "0" } },
        { "label": "On", "set": { "fxaa": "1" } }
      ],
      "defaults": { "fxaa": "0" }
    },
    {
      "id": "language",
      "label": "Game language",
      "help": "The language of the game's text and voices. Your dump has only some of them; one it doesn't have falls back to one it has.",
      "in": "app",
      "choices": [
        { "label": "English (US)", "set": { "language": "1" } },
        { "label": "English (UK)", "set": { "language": "18" } },
        { "label": "French", "set": { "language": "2" } },
        { "label": "German", "set": { "language": "4" } },
        { "label": "Italian", "set": { "language": "5" } },
        { "label": "Spanish (Spain)", "set": { "language": "3" } },
        { "label": "Spanish (Latin America)", "set": { "language": "20" } },
        { "label": "Portuguese (Brazil)", "set": { "language": "17" } },
        { "label": "Polish", "set": { "language": "16" } },
        { "label": "Russian", "set": { "language": "8" } }
      ],
      "defaults": { "language": "1" }
    },
    {
      "id": "vertical_sync",
      "label": "V-Sync",
      "choices": [
        { "label": "On", "set": { "vertical_sync": "1" } },
        { "label": "Off", "set": { "vertical_sync": "0" } }
      ],
      "defaults": { "vertical_sync": "0" }
    },
    {
      "id": "frame_rate",
      "label": "Frame rate",
      "help": "Above 60 the camera and characters move more smoothly.",
      "choices": [
        { "label": "30 FPS", "set": { "frame_rate": "30" } },
        { "label": "60 FPS (the game's own)", "set": { "frame_rate": "60" } },
        { "label": "90 FPS", "set": { "frame_rate": "90" } },
        { "label": "120 FPS", "set": { "frame_rate": "120" } },
        { "label": "144 FPS", "set": { "frame_rate": "144" } },
        { "label": "200 FPS (the game's maximum)", "set": { "frame_rate": "0" } }
      ],
      "defaults": { "frame_rate": "60" }
    }
  ]
}
